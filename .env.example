# Server/Edge Function settings only; never load this into the frontend.
# Configure via Supabase Edge Function Secrets or a local ignored .env file.
OPENAI_API_KEY=
# Select and clinically evaluate an OpenAI model with Responses structured outputs.
# Prefer a tested model snapshot. No model or provider is enabled by default.
EVERWELL_AI_MODEL=
EVERWELL_ANALYSIS_ENABLED=false
EVERWELL_ALLOWED_ORIGINS=http://localhost:8000
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are supplied
# by the Supabase Edge runtime. Never copy service-role credentials into browser code.
